# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables.
# The game runs with none of these set: no accounts and no payments, free decks only.

# --- Site -------------------------------------------------------------------
# Public URL, used for canonical links, sitemap and payment redirects in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@czechpexeso.net
# Shown on /privacy and /terms (who runs the site).
NEXT_PUBLIC_LEGAL_OPERATOR=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_COMPANY_ID=

# --- Supabase (Google sign-in, subscription status, cloud progress) ---------
# Project Settings → API. Either the new publishable/secret keys or the legacy anon/service_role keys work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# --- Paddle (payments) ------------------------------------------------------
# Sandbox and live are separate Paddle accounts: "sandbox" for testing, "production" for real payments.
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Developer tools → Authentication. The client-side token is public (test_… / live_…).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Server only — never expose.
PADDLE_API_KEY=
# Developer tools → Notifications → your destination → secret key.
PADDLE_WEBHOOK_SECRET=
# Price IDs — create them with `npm run paddle:setup`.
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
PADDLE_PRICE_LIFETIME=

# --- Local testing only -----------------------------------------------------
# Unlock Premium without Paddle while developing. Ignored in production builds.
DEV_PREMIUM=false
