# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables.
# The game runs with none of these set: no accounts and no payments, free decks only.

# --- Site -------------------------------------------------------------------
# Public URL, used for canonical links, sitemap and Stripe redirects in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@czechpexeso.net
# Shown on /privacy and /terms (who runs the site).
NEXT_PUBLIC_LEGAL_OPERATOR=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_COMPANY_ID=

# --- Supabase (Google sign-in, subscription status, cloud progress) ---------
# Project Settings → API. Either the new publishable/secret keys or the legacy anon/service_role keys work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# --- Stripe (payments) ------------------------------------------------------
# Developers → API keys. Use sk_test_ locally, sk_live_ in production.
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → Signing secret (or from `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Price IDs — create them with `npm run stripe:setup`.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Optional: free trial length in days (0 = no trial).
STRIPE_TRIAL_DAYS=0
# Optional: let Stripe Tax calculate EU VAT (enable Stripe Tax in the Dashboard first).
STRIPE_AUTOMATIC_TAX=false

# --- Local testing only -----------------------------------------------------
# Unlock Premium without Stripe while developing. Ignored in production builds.
DEV_PREMIUM=false
